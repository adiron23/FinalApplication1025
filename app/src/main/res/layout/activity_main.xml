<?xml version="1.0" encoding="utf-8"?>
<!--
  Main Dashboard
  Header:  gradient bg_header_gradient, dark text (11:1), curved bottom 36dp
  Cards:   white, 20dp radius, float over header via -36dp margin
  Spacing: 8dp grid throughout
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── Gradient Hero Header ───────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_header_gradient"
                android:paddingHorizontal="24dp"
                android:paddingTop="24dp"
                android:paddingBottom="56dp">

                <!-- Dark text on gradient — 11:1 contrast ratio -->
                <TextView
                    android:id="@+id/tVWelcome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="טוען נתונים..."
                    android:textColor="@color/colorOnPrimary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:lineSpacingMultiplier="1.2" />

                <TextView
                    android:id="@+id/tvFamilyName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/colorOnPrimaryMuted"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Cards float up over the curved header bottom -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="24dp"
                android:layout_marginTop="-36dp">

                <!-- ── Tasks Widget ──────────────────────────────────── -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="@color/colorSurface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Header row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="16dp">

                            <TextView
                                android:id="@+id/tvTasksWidgetTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="משימות"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/colorTextPrimary" />

                            <TextView
                                android:id="@+id/tvTasksCount"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:gravity="center"
                                android:textSize="11sp"
                                android:textColor="@color/white"
                                android:textStyle="bold"
                                android:background="@drawable/badge_circle"
                                android:visibility="gone"
                                android:layout_marginEnd="10dp" />

                            <TextView
                                android:id="@+id/tvTasksSeeAll"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="הכל ←"
                                android:textSize="13sp"
                                android:textColor="@color/colorPrimaryDark"
                                android:textStyle="bold"
                                android:padding="4dp" />

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/colorDivider"
                            android:layout_marginBottom="12dp" />

                        <LinearLayout
                            android:id="@+id/tasksWidgetContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/tvTasksEmpty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="כל המשימות הושלמו!"
                            android:textSize="14sp"
                            android:textColor="@color/colorSuccess"
                            android:gravity="center"
                            android:paddingVertical="16dp"
                            android:visibility="gone" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- ── Today's Events Widget ─────────────────────────── -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="@color/colorSurface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="16dp">

                            <!-- Turquoise dot accent -->
                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:background="@drawable/bg_circle_turquoise"
                                android:layout_marginEnd="10dp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="אירועי היום"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/colorTextPrimary" />

                            <TextView
                                android:id="@+id/tvEventsSeeAll"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="לוח שנה ←"
                                android:textSize="13sp"
                                android:textColor="@color/colorCalendarDark"
                                android:textStyle="bold"
                                android:padding="4dp" />

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/colorDivider"
                            android:layout_marginBottom="12dp" />

                        <LinearLayout
                            android:id="@+id/eventsWidgetContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/tvEventsEmpty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="אין אירועים להיום"
                            android:textSize="14sp"
                            android:textColor="@color/colorTextSecondary"
                            android:gravity="center"
                            android:paddingVertical="16dp"
                            android:visibility="gone" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- ── Shopping Widget ────────────────────────────────── -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="@color/colorSurface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="16dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="רשימת קניות"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/colorTextPrimary" />

                            <TextView
                                android:id="@+id/tvShoppingSeeAll"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="הכל ←"
                                android:textSize="13sp"
                                android:textColor="@color/colorPrimaryDark"
                                android:textStyle="bold"
                                android:padding="4dp" />

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/colorDivider"
                            android:layout_marginBottom="12dp" />

                        <LinearLayout
                            android:id="@+id/shoppingWidgetContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/tvShoppingEmpty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="הרשימה ריקה"
                            android:textSize="14sp"
                            android:textColor="@color/colorTextSecondary"
                            android:gravity="center"
                            android:paddingVertical="16dp"
                            android:visibility="gone" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
