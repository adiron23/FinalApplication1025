<?xml version="1.0" encoding="utf-8"?>
<!--
  Calendar screen — iOS-inspired clean month grid.
  White card contains the grid; events section below.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="96dp">

            <!-- ── Calendar card ──────────────────────────────────────────── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="12dp">

                    <!-- Month navigation header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="8dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="12dp">

                        <ImageButton
                            android:id="@+id/btnPrevMonth"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@android:drawable/ic_media_previous"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:scaleX="0.7"
                            android:scaleY="0.7"
                            app:tint="@color/colorGradientEnd"
                            android:contentDescription="חודש קודם" />

                        <TextView
                            android:id="@+id/tvMonthYear"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textSize="21sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorTextPrimary" />

                        <ImageButton
                            android:id="@+id/btnNextMonth"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@android:drawable/ic_media_next"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:scaleX="0.7"
                            android:scaleY="0.7"
                            app:tint="@color/colorGradientEnd"
                            android:contentDescription="חודש הבא" />

                        <ImageButton
                            android:id="@+id/btnSyncCalendar"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:src="@drawable/ic_sync_calendar"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:contentDescription="סנכרן עם Google Calendar"
                            android:layout_marginStart="2dp" />

                    </LinearLayout>

                    <!-- Day-of-week header row -->
                    <LinearLayout
                        android:id="@+id/rowDayHeaders"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="4dp">

                        <!-- Populated programmatically (א ב ג ד ה ו ש) -->

                    </LinearLayout>

                    <!-- Hairline divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/colorDivider"
                        android:layout_marginHorizontal="8dp"
                        android:layout_marginBottom="4dp" />

                    <!-- Day grid -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvDays"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── Events section ─────────────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/sectionEvents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvEventsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="בחר יום לצפייה באירועים"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary"
                    android:paddingHorizontal="4dp"
                    android:paddingBottom="12dp" />

                <!-- Events list (nestedScrollingEnabled false — outer NestedScrollView scrolls) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvEvents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

                <!-- Empty state -->
                <LinearLayout
                    android:id="@+id/layoutEmptyEvents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="32dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="אין אירועים ביום זה"
                        android:textSize="18sp"
                        android:textColor="@color/colorTextSecondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="לחץ על + להוספת אירוע"
                        android:textSize="16sp"
                        android:textColor="@color/colorGradientEnd"
                        android:layout_marginTop="6dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddEvent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="24dp"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="@color/colorGradientStart"
        app:tint="@color/colorGradientEnd"
        android:contentDescription="הוסף אירוע" />

</RelativeLayout>
