<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="100dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="12dp">

        <!-- Avatar circle (letter initial or real picture) with optional remove X -->
        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="8dp">

            <!-- Fallback: letter initial on coloured circle -->
            <TextView
                android:id="@+id/tvMemberAvatar"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:gravity="center"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/bg_avatar_circle" />

            <!-- Real profile picture (shown instead of the letter when available) -->
            <ImageView
                android:id="@+id/ivMemberAvatar"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_avatar_circle"
                android:visibility="gone" />

            <!-- Tap to remove — visible only for parents removing other members -->
            <TextView
                android:id="@+id/btnRemoveMember"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top|end"
                android:gravity="center"
                android:text="×"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@color/colorError"
                android:visibility="gone" />

        </FrameLayout>

        <!-- Name -->
        <TextView
            android:id="@+id/tvMemberName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Role chip -->
        <TextView
            android:id="@+id/tvMemberRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:textColor="@color/colorPrimary"
            android:background="@color/colorPrimaryVeryLight"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
