<?xml version="1.0" encoding="utf-8"?>
<!--
  Primary button: warm brown gradient.
  Ripple mask keeps press effect inside rounded corners.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#44FFFFFF">

    <!-- Mask: defines ripple bounds (clipped to rounded shape) -->
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- Gradient fill -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#8D6E63"
                android:endColor="#5D4037"
                android:angle="135"
                android:type="linear" />
            <corners android:radius="24dp" />
        </shape>
    </item>

</ripple>
