<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!--
    ════════════════════════════════════════════════════════════
      PRIMARY PALETTE  —  Warm Brown / Espresso
      colorPrimary is a DARK color — use cream (colorOnPrimary)
      as text ON primary surfaces.
    ════════════════════════════════════════════════════════════
    -->
    <color name="colorPrimary">#6D4C41</color>          <!-- medium brown -->
    <color name="colorPrimaryDark">#4E342E</color>       <!-- deep espresso -->
    <color name="colorPrimaryLight">#A1887F</color>      <!-- warm rose-brown -->
    <color name="colorPrimaryVeryLight">#F5EDE8</color>  <!-- cream tint — nav indicator, chips -->
    <color name="colorPrimaryContainer">#E8D5CC</color>  <!-- light container -->
    <color name="colorOnPrimary">#FAF0E6</color>         <!-- linen cream — text ON brown surfaces -->
    <color name="colorOnPrimaryMuted">#BCAAA4</color>    <!-- muted cream — secondary text on header -->

    <!-- Gradient endpoints (used in bg_header_gradient.xml) -->
    <color name="colorGradientStart">#8D6E63</color>     <!-- lighter warm brown top -->
    <color name="colorGradientEnd">#5D4037</color>       <!-- deep brown bottom -->

    <!--
    ════════════════════════════════════════════════════════════
      BACKGROUNDS
    ════════════════════════════════════════════════════════════
    -->
    <color name="colorBackground">#FAF0E6</color>        <!-- linen cream — warm and distinct from white -->
    <color name="colorSurface">#FDF6EC</color>           <!-- soft cream card surface -->
    <color name="colorSurfaceVariant">#EDE0D4</color>    <!-- warm tinted surface -->

    <!--
    ════════════════════════════════════════════════════════════
      TEXT
    ════════════════════════════════════════════════════════════
    -->
    <color name="colorTextPrimary">#3E2723</color>       <!-- dark espresso text -->
    <color name="colorTextSecondary">#8D6E63</color>     <!-- warm brown secondary -->
    <color name="colorTextHint">#BCAAA4</color>          <!-- muted hint text -->

    <!--
    ════════════════════════════════════════════════════════════
      UI CHROME
    ════════════════════════════════════════════════════════════
    -->
    <color name="colorDivider">#E8DDD3</color>           <!-- warm light divider -->
    <color name="colorIcon">#BCAAA4</color>              <!-- unselected nav icon -->
    <color name="colorIconSelected">#6D4C41</color>      <!-- selected nav icon -->

    <!--
    ════════════════════════════════════════════════════════════
      SEMANTIC
    ════════════════════════════════════════════════════════════
    -->
    <color name="colorError">#E53935</color>
    <color name="colorErrorBg">#FFF0F0</color>
    <color name="colorSuccess">#43A047</color>
    <color name="colorSuccessBg">#E8F5E9</color>
    <color name="colorWarning">#D97706</color>
    <color name="colorWarningBg">#FFFBEB</color>

    <!--
    ════════════════════════════════════════════════════════════
      TASK PRIORITY STRIPES
    ════════════════════════════════════════════════════════════
    -->
    <color name="colorPriorityUrgent">#E53935</color>
    <color name="colorPriorityNormal">#6D4C41</color>
    <color name="colorPriorityLow">#A1887F</color>

    <!--
    ════════════════════════════════════════════════════════════
      CALENDAR  —  Turquoise accent (#40E0D0) — unchanged
    ════════════════════════════════════════════════════════════
    -->
    <color name="colorCalendar">#40E0D0</color>
    <color name="colorCalendarDark">#00897B</color>
    <color name="colorCalendarLight">#E0F7FA</color>
    <color name="colorCalendarSurface">#F7FFFE</color>
</resources>
